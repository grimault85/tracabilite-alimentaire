# URL de l'Edge Function Supabase qui porte la clé API Anthropic.
# Sans elle, l'app fonctionne en saisie manuelle uniquement.
VITE_URL_EXTRACTION=https://TON-PROJET.supabase.co/functions/v1/lire-etiquette

# Jeton partagé, doit correspondre au secret JETON_APP de la fonction.
# Il sera visible dans le bundle : il limite l'usage, il ne le sécurise pas.
VITE_JETON_APP=
